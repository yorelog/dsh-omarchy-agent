{
  "schemaVersion": 1,
  "id": "dsh-omarchy-agent",
  "name": "DeepSeek Harness",
  "version": "0.4.3",
  "author": "yorelog",
  "license": "MIT",
  "description": "Adds Omarchy tools, a package guard, and a bar panel to DeepSeek Harness.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "integration/DshPanel.qml"
  },
  "barWidget": {
    "displayName": "DeepSeek Harness",
    "description": "Start or stop dsh web, open the web UI or the dsh CLI, and read Omarchy state.",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 3080,
      "workingDirectory": "",
      "permissionMode": "danger-full-access",
      "refreshIntervalSec": 10
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "Web UI port",
        "min": 1024,
        "max": 65535,
        "defaultValue": 3080
      },
      {
        "key": "workingDirectory",
        "type": "path",
        "label": "Working directory",
        "defaultValue": "",
        "description": "Defaults to ~/Work."
      },
      {
        "key": "permissionMode",
        "type": "enum",
        "label": "Permission mode",
        "options": [
          "danger-full-access",
          "workspace-write"
        ],
        "defaultValue": "danger-full-access"
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 3,
        "max": 300,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
