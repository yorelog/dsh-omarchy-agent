{
  "name": "dsh-omarchy-agent",
  "version": "0.3.7",
  "description": "Omarchy capabilities for DeepSeek Harness: live desktop tools, a package-ownership guard, web cards, and a top-bar panel.",
  "type": "module",
  "license": "MIT",
  "author": "yorelog",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yorelog/dsh-omarchy-agent.git"
  },
  "homepage": "https://github.com/yorelog/dsh-omarchy-agent#readme",
  "bugs": {
    "url": "https://github.com/yorelog/dsh-omarchy-agent/issues"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "manifest.json",
    "integration/**",
    "scripts/**",
    "install.sh",
    "uninstall.sh",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-omarchy-agent-install": "install.sh",
    "dsh-omarchy-agent-uninstall": "uninstall.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:client": "node scripts/smoke-client.mjs",
    "version": "node scripts/bump-manifest.mjs",
    "setup": "bash install.sh",
    "uninstall": "bash uninstall.sh"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "omarchy",
    "hyprland",
    "agent",
    "bar-widget"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "esbuild": "0.25.0",
    "react": "18.3.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
