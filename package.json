{
  "name": "dsh-omarchy-agent",
  "version": "0.2.0",
  "description": "Omarchy (Arch Linux + Hyprland) capabilities for DeepSeek Harness: state tools, a command catalog, theme and Hyprland control, diagnostics, and a package-ownership guard.",
  "type": "module",
  "license": "MIT",
  "author": "yorelog",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "manifest.json",
    "integration/**",
    "scripts/**",
    "install.sh",
    "uninstall.sh",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "icon": "./icon.svg",
  "bin": {
    "dsh-omarchy-agent-install": "install.sh",
    "dsh-omarchy-agent-uninstall": "uninstall.sh"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version": "node scripts/bump-manifest.mjs",
    "setup": "bash install.sh",
    "uninstall": "bash uninstall.sh"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "omarchy",
    "hyprland",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-util-values": "*",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
